{
  "manifest_version": 3,
  "name": "Manual Link Trace Recorder",
  "version": "1.0.0",
  "description": "Record the links you follow while manually researching contact paths and export them to CSV.",
  "permissions": [
    "storage",
    "downloads",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Manual Link Trace Recorder",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
